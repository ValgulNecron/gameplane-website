{"type":"frame","id":"IGuE6","x":0,"y":16259,"name":"Screen/Features","theme":{"H:Mode":"Dark"},"width":1440,"fill":"$H:--background","layout":"vertical","children":[{"id":"FxW8k","type":"ref","ref":"Qczsa","name":"Nav","width":"fill_container"},{"type":"frame","id":"Tagkk","name":"FeaturesBody","width":"fill_container","fill":"$H:--background","layout":"vertical","gap":48,"padding":[80,80,96,80],"alignItems":"center","children":[{"type":"frame","id":"Ap5j4","name":"header","width":"fill_container","layout":"vertical","gap":12,"alignItems":"center","children":[{"type":"text","id":"vgl1V","fill":"$H:--primary","content":"FEATURES","textAlign":"center","fontFamily":"$H:--font-primary","fontSize":12,"fontWeight":"600","letterSpacing":1},{"type":"text","id":"oHTyF","fill":"$H:--foreground","textGrowth":"fixed-width","width":700,"content":"Every feature you need to run a fleet of game servers","textAlign":"center","fontFamily":"$H:--font-primary","fontSize":34,"fontWeight":"700"},{"type":"text","id":"q4CGbE","fill":"$H:--muted-foreground","textGrowth":"fixed-width","width":640,"content":"From provisioning to backups, RBAC to observability — a closer look at how each piece works.","textAlign":"center","fontFamily":"$H:--font-secondary","fontSize":16,"fontWeight":"normal"}]},{"type":"frame","id":"eF2QT","name":"featureList","width":840,"layout":"vertical","gap":40,"children":[{"type":"frame","id":"vgYrC","name":"Kubernetes-native by design","width":"fill_container","gap":24,"children":[{"type":"frame","id":"g3FI8","name":"iconTile","width":56,"height":56,"fill":"$H:--secondary","cornerRadius":12,"justifyContent":"center","alignItems":"center","children":[{"type":"icon","id":"wFvlw","width":26,"height":26,"icon":"boxes","library":"lucide","fill":"$H:--primary"}]},{"type":"frame","id":"PWfSx","width":"fill_container","layout":"vertical","gap":8,"children":[{"type":"text","id":"VHnao","fill":"$H:--foreground","content":"Kubernetes-native by design","fontFamily":"$H:--font-primary","fontSize":20,"fontWeight":"600"},{"type":"text","id":"P3xKn","fill":"$H:--muted-foreground","textGrowth":"fixed-width","width":"fill_container","content":"Eight purpose-built Custom Resource Definitions — GameServer, GameTemplate, Cluster, Backup, BackupSchedule, Restore, Module, and ModuleSource — are reconciled by a single controller-runtime operator. Whether you create a server through the dashboard or with kubectl apply, the outcome is identical: the operator is the single source of truth.","lineHeight":1.6,"fontFamily":"$H:--font-secondary","fontSize":14,"fontWeight":"normal"}]}]},{"type":"frame","id":"meLYA","name":"Scales from homelab to production","width":"fill_container","gap":24,"children":[{"type":"frame","id":"cu3Da","name":"iconTile","width":56,"height":56,"fill":"$H:--secondary","cornerRadius":12,"justifyContent":"center","alignItems":"center","children":[{"type":"icon","id":"vCdHd","width":26,"height":26,"icon":"layers","library":"lucide","fill":"$H:--primary"}]},{"type":"frame","id":"ZhG2L","width":"fill_container","layout":"vertical","gap":8,"children":[{"type":"text","id":"c6JAf","fill":"$H:--foreground","content":"Scales from homelab to production","fontFamily":"$H:--font-primary","fontSize":20,"fontWeight":"600"},{"type":"text","id":"wXsJu","fill":"$H:--muted-foreground","textGrowth":"fixed-width","width":"fill_container","content":"The exact same CRDs, controllers, and Helm chart that run on a single-node k3s homelab also run on a multi-node production cluster. There's no separate 'production mode' to migrate to — StatefulSets, PVCs, and rolling upgrades from day one.","lineHeight":1.6,"fontFamily":"$H:--font-secondary","fontSize":14,"fontWeight":"normal"}]}]},{"type":"frame","id":"b1INn","name":"Live console & RCON","width":"fill_container","gap":24,"children":[{"type":"frame","id":"TAZBo","name":"iconTile","width":56,"height":56,"fill":"$H:--secondary","cornerRadius":12,"justifyContent":"center","alignItems":"center","children":[{"type":"icon","id":"PHPF7","width":26,"height":26,"icon":"terminal","library":"lucide","fill":"$H:--primary"}]},{"type":"frame","id":"ngrNT","width":"fill_container","layout":"vertical","gap":8,"children":[{"type":"text","id":"Fyj6C","fill":"$H:--foreground","content":"Live console & RCON","fontFamily":"$H:--font-primary","fontSize":20,"fontWeight":"600"},{"type":"text","id":"U0cEtf","fill":"$H:--muted-foreground","textGrowth":"fixed-width","width":"fill_container","content":"An in-pod agent sidecar streams the console over WebSocket and speaks each game's native protocol — Source RCON, telnet, Rust WebRcon, BattlEye, or a REST admin API — no SSH, no kubectl exec, no separate client required.","lineHeight":1.6,"fontFamily":"$H:--font-secondary","fontSize":14,"fontWeight":"normal"}]}]},{"type":"frame","id":"sdciG","name":"In-browser file manager","width":"fill_container","gap":24,"children":[{"type":"frame","id":"AQv6N","name":"iconTile","width":56,"height":56,"fill":"$H:--secondary","cornerRadius":12,"justifyContent":"center","alignItems":"center","children":[{"type":"icon","id":"RIvjx","width":26,"height":26,"icon":"folder-code","library":"lucide","fill":"$H:--primary"}]},{"type":"frame","id":"FOzD9","width":"fill_container","layout":"vertical","gap":8,"children":[{"type":"text","id":"Dtbkx","fill":"$H:--foreground","content":"In-browser file manager","fontFamily":"$H:--font-primary","fontSize":20,"fontWeight":"600"},{"type":"text","id":"yUUPH","fill":"$H:--muted-foreground","textGrowth":"fixed-width","width":"fill_container","content":"Browse, edit, upload, and download files on a running server's data volume straight from the dashboard, with a full Monaco editor — the same engine behind VS Code — for config files, scripts, and datapacks.","lineHeight":1.6,"fontFamily":"$H:--font-secondary","fontSize":14,"fontWeight":"normal"}]}]},{"type":"frame","id":"CBuj0","name":"Backups & one-click restore","width":"fill_container","gap":24,"children":[{"type":"frame","id":"gEMEP","name":"iconTile","width":56,"height":56,"fill":"$H:--secondary","cornerRadius":12,"justifyContent":"center","alignItems":"center","children":[{"type":"icon","id":"f0LCeG","width":26,"height":26,"icon":"archive-restore","library":"lucide","fill":"$H:--primary"}]},{"type":"frame","id":"Z4SPeg","width":"fill_container","layout":"vertical","gap":8,"children":[{"type":"text","id":"L2QpE","fill":"$H:--foreground","content":"Backups & one-click restore","fontFamily":"$H:--font-primary","fontSize":20,"fontWeight":"600"},{"type":"text","id":"RMbxl","fill":"$H:--muted-foreground","textGrowth":"fixed-width","width":"fill_container","content":"Scheduled or on-demand snapshots are pushed to any S3-compatible storage backend using restic, giving you deduplicated, encrypted, incremental backups. Restoring is a single click from the dashboard's Backups tab.","lineHeight":1.6,"fontFamily":"$H:--font-secondary","fontSize":14,"fontWeight":"normal"}]}]},{"type":"frame","id":"iyN9o","name":"Game module system","width":"fill_container","gap":24,"children":[{"type":"frame","id":"Z1qtCQ","name":"iconTile","width":56,"height":56,"fill":"$H:--secondary","cornerRadius":12,"justifyContent":"center","alignItems":"center","children":[{"type":"icon","id":"gXfNS","width":26,"height":26,"icon":"puzzle","library":"lucide","fill":"$H:--primary"}]},{"type":"frame","id":"EgDRY","width":"fill_container","layout":"vertical","gap":8,"children":[{"type":"text","id":"djv9y","fill":"$H:--foreground","content":"Game module system","fontFamily":"$H:--font-primary","fontSize":20,"fontWeight":"600"},{"type":"text","id":"u01fFT","fill":"$H:--muted-foreground","textGrowth":"fixed-width","width":"fill_container","content":"Sixteen games ship out of the box, and the open template format supports any game with a config file and a start command.","lineHeight":1.6,"fontFamily":"$H:--font-secondary","fontSize":14,"fontWeight":"normal"}]}]},{"type":"frame","id":"dTIGp","name":"RBAC + OIDC auth","width":"fill_container","gap":24,"children":[{"type":"frame","id":"Sor7k","name":"iconTile","width":56,"height":56,"fill":"$H:--secondary","cornerRadius":12,"justifyContent":"center","alignItems":"center","children":[{"type":"icon","id":"wAkcj","width":26,"height":26,"icon":"shield-check","library":"lucide","fill":"$H:--primary"}]},{"type":"frame","id":"wT6Ur","width":"fill_container","layout":"vertical","gap":8,"children":[{"type":"text","id":"MqoUL","fill":"$H:--foreground","content":"RBAC + OIDC auth","fontFamily":"$H:--font-primary","fontSize":20,"fontWeight":"600"},{"type":"text","id":"Y85sbm","fill":"$H:--muted-foreground","textGrowth":"fixed-width","width":"fill_container","content":"Authenticate with local accounts or federate through OIDC — Keycloak, Google, or GitHub. Three built-in roles (admin, operator, viewer) scope access per namespace, so a shared cluster can host multiple teams safely.","lineHeight":1.6,"fontFamily":"$H:--font-secondary","fontSize":14,"fontWeight":"normal"}]}]},{"type":"frame","id":"au8kN","name":"Audit logging & observability","width":"fill_container","gap":24,"children":[{"type":"frame","id":"C1hs3","name":"iconTile","width":56,"height":56,"fill":"$H:--secondary","cornerRadius":12,"justifyContent":"center","alignItems":"center","children":[{"type":"icon","id":"u4p2u","width":26,"height":26,"icon":"activity","library":"lucide","fill":"$H:--primary"}]},{"type":"frame","id":"a5iXP","width":"fill_container","layout":"vertical","gap":8,"children":[{"type":"text","id":"V78ZI9","fill":"$H:--foreground","content":"Audit logging & observability","fontFamily":"$H:--font-primary","fontSize":20,"fontWeight":"600"},{"type":"text","id":"JYkk4","fill":"$H:--muted-foreground","textGrowth":"fixed-width","width":"fill_container","content":"Every mutating API request is logged to the database and exportable as CSV or JSON, with optional mirroring to stdout, a webhook, or syslog. Fleet-wide Prometheus metrics and a bundled Grafana dashboard come from the same install.","lineHeight":1.6,"fontFamily":"$H:--font-secondary","fontSize":14,"fontWeight":"normal"}]}]}]},{"type":"frame","id":"xBUVU","name":"cta","width":"fill_container","layout":"vertical","gap":20,"padding":[48,0,0,0],"alignItems":"center","children":[{"type":"text","id":"aFOeA","fill":"$H:--foreground","content":"Ready to try it in your own cluster?","textAlign":"center","fontFamily":"$H:--font-primary","fontSize":22,"fontWeight":"700"},{"type":"frame","id":"eDP9u","name":"ctaRow","gap":16,"alignItems":"center","children":[{"id":"hthF7","type":"ref","ref":"H:ZGI9Z","descendants":{"H:oNDwn":{"type":"icon","id":"GQc9i","width":24,"height":24,"icon":"github","library":"lucide","fill":"$H:--primary-foreground"},"H:J3Z6N":{"content":"GitHub"}}},{"id":"MvFvK","type":"ref","ref":"H:EAwax","descendants":{"H:nHmDC":{"type":"icon","id":"C021vl","width":24,"height":24,"icon":"play","library":"lucide","fill":"$H:--foreground"},"H:kqX7U":{"content":"Demo"}}}]}]}]},{"id":"rSneO","type":"ref","ref":"gnZrl","name":"Footer","width":"fill_container"}]}
