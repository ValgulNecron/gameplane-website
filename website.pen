                      "children": [
                        {
                          "type": "text",
                          "id": "c6JAf",
                          "fill": "$H:--foreground",
                          "content": "Scales from homelab to production",
                          "fontFamily": "$H:--font-primary",
                          "fontSize": 20,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "wXsJu",
                          "fill": "$H:--muted-foreground",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The exact same CRDs, controllers, and Helm chart that run on a single-node k3s homelab also run on a multi-node production cluster. There's no separate 'production mode' to migrate to — StatefulSets, PVCs, and rolling upgrades from day one.",
                          "lineHeight": 1.6,
                          "fontFamily": "$H:--font-secondary",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
