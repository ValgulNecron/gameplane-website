                },
                {
                  "type": "text",
                  "id": "GgJ13",
                  "fill": "$H:--muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": 700,
                  "content": "Common questions before you deploy Gameplane to your cluster.",
                  "fontFamily": "$H:--font-secondary",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "d9OBmF",
                  "width": "fill_container",
                  "gap": 32,
                  "children": [
                    {
                      "type": "frame",
                      "id": "jfw6L",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 16,
                      "children": [
                        {
                          "type": "frame",
                          "id": "SnzjF",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "bf9ym",
                              "fill": "$H:--foreground",
                              "content": "Do I need to know Kubernetes?",
                              "fontFamily": "$H:--font-primary",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "ANhU4",
                              "fill": "$H:--muted-foreground",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "One-time cluster setup benefits from basic Helm familiarity. Day-to-day server management — console, files, backups, players — is entirely dashboard-driven; kubectl is optional.",
                              "lineHeight": 1.5,
                              "fontFamily": "$H:--font-secondary",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "x0tsnt",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "D8m6ZT",
                              "fill": "$H:--foreground",
                              "content": "Is Gameplane production-ready?",
                              "fontFamily": "$H:--font-primary",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "vmvVd",
                              "fill": "$H:--muted-foreground",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "It's in beta (v0.2.0-beta.7). Core workflows are feature-complete and tested, but not yet recommended for unattended production — see the Roadmap.",
                              "lineHeight": 1.5,
                              "fontFamily": "$H:--font-secondary",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "MovBr",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "Qmybr",
                              "fill": "$H:--foreground",
                              "content": "Is it free?",
                              "fontFamily": "$H:--font-primary",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "MSHM9",
                              "fill": "$H:--muted-foreground",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Yes. Gameplane is open-source under AGPL-3.0-or-later, with no paid tiers.",
                              "lineHeight": 1.5,
                              "fontFamily": "$H:--font-secondary",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "U5LykJ",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 16,
                      "children": [
                        {
                          "type": "frame",
                          "id": "t3lNa1",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "PWXT9",
                              "fill": "$H:--foreground",
                              "content": "What happens to my data if I uninstall?",
                              "fontFamily": "$H:--font-primary",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "uTWW3",
                              "fill": "$H:--muted-foreground",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Depends on your cluster's StorageClass reclaim policy — Gameplane doesn't force-delete PVCs itself. Back up critical data before uninstalling.",
                              "lineHeight": 1.5,
                              "fontFamily": "$H:--font-secondary",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "yuE2x",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "bGbwW",
                              "fill": "$H:--foreground",
                              "content": "What database does it use?",
                              "fontFamily": "$H:--font-primary",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "q1SHgn",
                              "fill": "$H:--muted-foreground",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "SQLite by default and is the production-tested driver. A PostgreSQL driver exists but is experimental (build-tag-gated, work in progress).",
                              "lineHeight": 1.5,
                              "fontFamily": "$H:--font-secondary",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "K9jX1E",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 4,
                          "children": [
                            {
                              "type": "text",
                              "id": "NvXnf",
                              "fill": "$H:--foreground",
                              "content": "Can I manage servers without the dashboard?",
                              "fontFamily": "$H:--font-primary",
                              "fontSize": 14,
                              "fontWeight": "600"
                            },
                            {
                              "type": "text",
                              "id": "g0bJb4",
                              "fill": "$H:--muted-foreground",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Yes. Advanced users can bypass the API entirely and manage everything with kubectl apply — the operator is authoritative, so both stay in sync.",
                              "lineHeight": 1.5,
                              "fontFamily": "$H:--font-secondary",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
